# copy to .env and fill in
ATLAS_SRV=mongodb+srv://<db_user>:<password>@cluster1.6lqaurg.mongodb.net/?appName=Cluster1
DATABASE_NAME=test            # "partyy" on the live server, "test" for local dev
PORT=3000
URL=http://localhost:3000
SESSION_SECRET=change-me

# Self-hosted audio
AUDIO_DIR=./audio             # where ingested MP3s live (server streams 30s windows from here)
INGEST_MODE=local             # local = this machine downloads; remote = leave jobs for scripts/ingest-worker.js

# Optional, only for the old Google login / Spotify OAuth paths
GOOGLE_CLIENT_ID=
SPOTIFY_ID=
SPOTIFY_SECRET=
